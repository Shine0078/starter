# Copy this file to a private file such as ~/finverse-cloudrun.env.yaml in
# Cloud Shell. Never commit the filled-in copy. YAML values are strings.
NODE_ENV: "production"
STORE: "postgres"
MIGRATE_ON_BOOT: "false"
TRUST_PROXY_HOPS: "1"
CORS_ORIGINS: "https://REPLACE_WITH_CLOUD_RUN_URL"

# Neon direct URLs. DATABASE_URL is the schema owner used only by the job;
# DATABASE_APP_URL uses finverse_app and is used by the running service.
DATABASE_URL: "postgresql://OWNER:OWNER_PASSWORD@DIRECT_HOST/DB?sslmode=require"
DATABASE_APP_URL: "postgresql://finverse_app:APP_PASSWORD@DIRECT_HOST/DB?sslmode=require"

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET: "REPLACE_WITH_RANDOM_SECRET"
MFA_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"
BANK_TOKEN_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_BYTE_KEY"
HIBP_PASSWORD_CHECK: "required"

# Replace these placeholders with the reviewed, HTTPS legal documents before
# selling. Production intentionally refuses to boot without all four values.
LEGAL_TERMS_VERSION: "v1"
LEGAL_TERMS_URL: "https://REPLACE_WITH_YOUR_DOMAIN/legal/terms/v1"
LEGAL_PRIVACY_VERSION: "v1"
LEGAL_PRIVACY_URL: "https://REPLACE_WITH_YOUR_DOMAIN/legal/privacy/v1"
