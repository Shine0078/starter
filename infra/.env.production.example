# Copy to infra/.env.production and fill every value before starting the public
# stack. Keep this file out of source control; it contains production secrets.
NODE_ENV=production
STORE=postgres
MIGRATE_ON_BOOT=false
PORT=3000

# Use the restricted runtime database role here. Run migrations separately with
# the schema-owner DATABASE_URL described in docs/09-launch-operations.md.
DATABASE_APP_URL=postgresql://finverse_app:change-me@db.example.com/finverse
JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
BANK_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Required in production. Uses HIBP's privacy-preserving five-character hash
# range protocol; it does not need a credential and never sends a password.
HIBP_PASSWORD_CHECK=required

# Comma-separated browser origins allowed to call the API. The bundled public
# stack serves the PWA from PUBLIC_API_DOMAIN, so use that exact origin unless
# the web client is deployed separately.
CORS_ORIGINS=https://api.example.com
TRUST_PROXY_HOPS=1
# Bearer token required by the internal Prometheus scrape endpoint.
METRICS_TOKEN=replace-with-a-random-metrics-token

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=FINVERSE <no-reply@example.com>

LEGAL_TERMS_VERSION=replace-with-reviewed-version
LEGAL_TERMS_URL=https://app.example.com/legal/terms/replace-with-reviewed-version
LEGAL_PRIVACY_VERSION=replace-with-reviewed-version
LEGAL_PRIVACY_URL=https://app.example.com/legal/privacy/replace-with-reviewed-version

PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me
PLAID_ENVIRONMENT=production
PLAID_COUNTRIES=CA,US
PLAID_WEBHOOK_URL=https://api.example.com/api/bank-webhooks/plaid
PLAID_IOS_REDIRECT_URI=https://api.example.com/plaid/
IOS_TEAM_ID=replace-with-10-character-apple-team-id

# Passkeys (WebAuthn) — same host as the deployment origin, HTTPS required.
# WEBAUTHN_ENABLED=true
# WEBAUTHN_RP_ID=api.example.com
# WEBAUTHN_ORIGIN=https://api.example.com
# WEBAUTHN_RP_NAME=FINVERSE

# Remote push provider credentials (FCM/APNs) when delivery is configured.
# FCM_CREDENTIALS_JSON=replace-me
