# Copy to infra/.env.oracle on the Oracle VM. Never commit the copy.
# Use URL-safe random values without spaces, #, or $ in database passwords.
PUBLIC_API_DOMAIN=YOUR_PUBLIC_HOSTNAME

POSTGRES_USER=finverse_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=finverse
DATABASE_URL=postgresql://finverse_owner:replace-with-a-long-random-password@db:5432/finverse
DATABASE_APP_URL=postgresql://finverse_app:replace-with-a-different-long-random-password@db:5432/finverse

JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-32-byte-value
BANK_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-value
HIBP_PASSWORD_CHECK=required
CORS_ORIGINS=https://YOUR_PUBLIC_HOSTNAME
TRUST_PROXY_HOPS=1
METRICS_TOKEN=replace-with-a-random-token-at-least-16-characters

# Production requires reviewed HTTPS legal documents.
LEGAL_TERMS_VERSION=2026-01
LEGAL_TERMS_URL=https://YOUR_PUBLIC_HOSTNAME/legal/terms/2026-01
LEGAL_PRIVACY_VERSION=2026-01
LEGAL_PRIVACY_URL=https://YOUR_PUBLIC_HOSTNAME/legal/privacy/2026-01

# Leave bank credentials unset until Plaid approves production access.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=production
# PLAID_COUNTRIES=CA,US
