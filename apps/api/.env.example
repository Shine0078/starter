# Copy to .env for local overrides. Never commit a real .env.

PORT=3000

# Postgres (npm run infra:up). Unused until the Postgres adapter lands —
# the API stores everything in memory today.
DATABASE_URL=postgresql://finverse:finverse_dev_only@localhost:5432/finverse

REDIS_URL=redis://localhost:6379

# Which AggregatorPort implementation to use.
# `mock` is the only one that exists; plaid/flinks/truelayer arrive in Phase 1
# and each needs a signed commercial agreement before it can be enabled.
AGGREGATOR=mock

# Real aggregator credentials go here once there is a contract. These are the
# highest-value secrets in the system — see docs/03-security-privacy.md.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
