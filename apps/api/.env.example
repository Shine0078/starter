# Copy to .env for local overrides. Never commit a real .env.

PORT=3000

# --- Identity -----------------------------------------------------------------

# Signs access tokens. REQUIRED in production; the process refuses to start
# without it rather than falling back to a built-in default, because a default
# signing key committed to a repository is a universal forgery key — anyone can
# mint a token for any user.
#
# In development, a random key is generated per boot, which means restarting
# signs everyone out. That is the intended trade.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# Encrypts TOTP authenticator secrets at rest. REQUIRED in production. Keep it
# in the host secret manager and back it up separately; losing it locks every
# MFA-enabled user out. Exactly 32 random bytes, canonical base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API. REQUIRED in
# production; reflecting any origin would let a malicious page make credentialed
# cross-origin requests. Unset in development means "allow any".
# CORS_ORIGINS=https://app.finverse.example,https://finverse.example

# --- Legal registration gate -------------------------------------------------

# All four are REQUIRED in production. They must identify the exact reviewed
# documents shown at registration; changing a document means publishing a new
# immutable version and updating its version id and HTTPS URL here.
# LEGAL_TERMS_VERSION=terms-2026-08
# LEGAL_TERMS_URL=https://finverse.example/legal/terms/terms-2026-08
# LEGAL_PRIVACY_VERSION=privacy-2026-08
# LEGAL_PRIVACY_URL=https://finverse.example/legal/privacy/privacy-2026-08

# --- Persistence --------------------------------------------------------------

# Present => the Postgres adapter is used. Absent => in-memory, lost on restart.
#
# This is the schema OWNER. It is used for migrations and for creating the role
# below, and nothing else â€” on most installs it is a superuser, and a superuser
# bypasses every row-level security policy without reporting anything.
DATABASE_URL=postgresql://finverse:finverse_dev_only@localhost:5432/finverse

# The role that actually serves requests. Created (and its password kept in
# sync) by the migration step from the credentials in this URL, so it does not
# have to exist beforehand.
#
# Leaving this unset is supported and the API still runs â€” it just serves
# requests as the owner, which means user isolation rests on application code
# alone. The startup log says so when that happens.
DATABASE_APP_URL=postgresql://finverse_app:finverse_app_dev_only@localhost:5432/finverse

# Force an adapter explicitly: postgres | memory
# STORE=postgres

# Migrations run on boot in development. Set false in production and run them as
# a deploy step, so two instances starting together cannot race.
# MIGRATE_ON_BOOT=false

# --- Bank connections ---------------------------------------------------------

# A mock generator remains available only for local development and tests.
# The development-only sample generator is available through POST /api/sync
# outside production. Real connections use Plaid below.

# Plaid Sandbox credentials come from Developers > Keys in the Plaid Dashboard. These are
# highest-value secrets in the system — see docs/03-security-privacy.md.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=sandbox
# PLAID_COUNTRIES=CA,US

# Required whenever Plaid is enabled. Exactly 32 random bytes, base64 encoded.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BANK_TOKEN_ENCRYPTION_KEY=

# Public HTTPS endpoint for signed transaction-update webhooks. Optional in
# Sandbox/local development and required for Plaid production.
# PLAID_WEBHOOK_URL=https://api.example.com/api/bank-webhooks/plaid

# --- Billing ------------------------------------------------------------------

# Absent => billing is off, AND no plan limits are enforced. That pairing is
# deliberate: nobody should be refused a feature for not paying on a deployment
# where paying is impossible. Setting this key is what switches pricing on;
# there is no second flag. See docs/09-pricing.md.
#
# Card details never reach this system. Checkout and card management both happen
# on Stripe's hosted pages, which is what keeps PCI DSS out of scope. Do not add
# a card form to this application without reading docs/03-security-privacy.md.
# STRIPE_SECRET_KEY=sk_test_...

# REQUIRED whenever STRIPE_SECRET_KEY is set, and the process refuses to start
# without it. Missing it means every webhook is rejected, so customers would be
# charged and never receive the plan they paid for.
#   stripe listen --forward-to localhost:3000/api/billing-webhooks/stripe
# prints one for local development.
# STRIPE_WEBHOOK_SECRET=whsec_...

# The recurring prices the Pro plan sells, from Products in the Stripe Dashboard.
# At least one is required when Stripe is configured. The amounts live in
# Stripe, deliberately: duplicating them here would create a second source of
# truth that eventually disagrees with the one taking the money.
#
# Recommended: $8.99 monthly, $79 yearly. See docs/09-pricing.md for why.
# STRIPE_PRICE_ID_PRO_MONTHLY=price_...
# STRIPE_PRICE_ID_PRO_ANNUAL=price_...

# Free-trial length on a new subscription. 0 disables the trial.
# The app states the charge that follows plainly, because a trial that quietly
# becomes a charge costs more in refunds than it gains in signups.
# BILLING_TRIAL_DAYS=14

# Where Stripe returns the customer afterwards. HTTPS is required once billing
# is enabled in production, because these are redirect targets carrying the
# trust of a payment flow. Default to localhost in development.
# BILLING_SUCCESS_URL=https://app.example.com/billing/success
# BILLING_CANCEL_URL=https://app.example.com/billing/cancel
# BILLING_PORTAL_RETURN_URL=https://app.example.com/billing

# --- Test-only ----------------------------------------------------------------

# Set by the test harness only. Never set this anywhere else: it disables
# per-IP rate limiting.
# THROTTLE_DISABLED=true
