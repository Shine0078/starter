{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // embedded-postgres publishes its types through an "exports" map, which
    // classic "node" resolution cannot follow. Pointing at the declaration file
    // directly keeps real types for the one dev script that uses it, without
    // moving the whole CommonJS/Nest build onto node16 resolution.
    "baseUrl": ".",
    "paths": {
      "embedded-postgres": ["../../node_modules/embedded-postgres/dist/index.d.ts"]
    },
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "transpileOnly": true
  }
}
