<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FINVERSE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>finverse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  App Transport Security.

	  iOS blocks plain HTTP by default, which is correct: this app carries
	  financial data and must never negotiate a cleartext connection to a real
	  server. The exception below is scoped as narrowly as the platform allows —
	  `localhost` only, which reaches nothing but the machine the app is running
	  on (the iOS Simulator talking to a dev API on the same Mac).

	  It deliberately does NOT allow arbitrary cleartext loads. To reach a dev
	  API on another machine — a Windows PC on your LAN, say — put HTTPS in
	  front of it rather than widening this. A release build must use the
	  configured HTTPS API origin; see docs/11-run-on-your-phone.md.

	  NSAllowsLocalNetworking permits cleartext to .local and literal LAN
	  addresses without disabling ATS for the public internet, so a release
	  build still cannot be talked into an unencrypted connection to a server.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Required from iOS 14 for any connection to a device on the local
	     network, including a development API on your own LAN. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>FINVERSE connects to a development server on your local network when you are testing a build.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock FINVERSE and protect your financial information.</string>
	<key>NSCameraUsageDescription</key>
	<string>FINVERSE uses your camera only when you choose to scan a receipt on this device. Receipt images are never uploaded.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FINVERSE lets you choose a receipt photo to read on this device. Receipt images are never uploaded.</string>
	<!-- iOS schedules this opportunistically; it is never used for time-critical
	     banking decisions. The identifier must exactly match the Workmanager
	     unique name in lib/api/platform/background_sync_native.dart. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.finverse.finance.background-sync</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
